FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -o /crawler ./cmd/crawler

FROM alpine:3.22
RUN apk add --no-cache ca-certificates && adduser -D miner && mkdir /data && chown miner:miner /data
COPY --from=build /crawler /usr/local/bin/crawler
USER miner
ENTRYPOINT ["crawler"]
CMD ["-out", "/data", "-interval", "30m"]
